# =========================================================================
# VyaparSetu — Environment Configuration Template (.env.example)
# Copy this file to .env and configure with your actual credentials.
# NEVER commit the active .env file to version control.
# =========================================================================

# Application Settings
PROJECT_NAME="VyaparSetu"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (SQLite default for local development, PostgreSQL compatible)
DATABASE_URL="sqlite:///./vyaparsetu.db"

# JWT Authentication (Replace with a strong random 256-bit secret in production)
SECRET_KEY="your-random-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# BharatCode Hosted LLM Configuration (Sole Runtime LLM Provider)
# Obtain your API key from https://bharatcode.ai
BHARATCODE_API_KEY="your_bharatcode_api_key_here"
BHARATCODE_BASE_URL="https://bharatcode.ai/api/model/v1"
BHARATCODE_MODEL_NAME="qwen-3.8-27b"

# AI Operation Mode: PRODUCTION_BHARATCODE or DEV_SIMULATION
AI_MODE="PRODUCTION_BHARATCODE"

# Multi-Tenant File Storage Directory
STORAGE_DIR="./storage"
